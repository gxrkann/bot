# ---- Bot ----
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
OWNER_ID=
OWNER_ID_2=
BOT_NAME=Guard Bot

# Developer Portal > Bot > Intents (üçü de açık olmalı)
ENABLE_MESSAGE_CONTENT_INTENT=true
ENABLE_GUILD_MEMBERS_INTENT=true

# ---- Dashboard ----
DASHBOARD_ENABLED=true

# Hosting panelinin atadığı port. bot-hosting.net PORT değişkenini
# otomatik verir; elle yazmana gerek yok.
# PORT=3000
# DASHBOARD_PORT=3000

# Panelin verdiği HTTPS adresi (Domains sekmesinden bak).
# DASHBOARD_PUBLIC_URL=https://xxx.apps.bot-hosting.cloud

# Discord Developer Portal > OAuth2 > URL Generator
# Scopes: identify, guilds
# Redirect URI: panelin verdiği adres + /auth/callback
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=

# Boş bırakırsan istek adresinden otomatik tahmin edilir (proxy arkasında çalışır).
# Elle yazmak daha güvenli:
# DASHBOARD_REDIRECT_URI=https://xxx.apps.bot-hosting.cloud/auth/callback

# Panele girebilecek Discord kullanıcı ID'leri (virgülle ayır).
# BOŞ BIRAKIRSA KİMSE GİREMEZ. OWNER_ID otomatik dahil edilir.
DASHBOARD_ALLOWED_IDS=

DEFAULT_LOG_CHANNEL=
